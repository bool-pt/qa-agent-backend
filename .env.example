# =============================================================================
# Required for the Docker stack (docker compose up).
# =============================================================================

# Anthropic API key. OpenClaw uses this to drive the qa-executor agent.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token your ODC app must send in the Authorization header on every
# call to POST /test_user_story (and GET /artifacts/...). The same token is
# also sent BACK by this server on the outbound webhook to CALLBACK_URL —
# your ODC endpoint should validate it. Generate one with:
#   openssl rand -hex 32
BEARER_TOKEN=replace-me-with-openssl-rand-hex-32

# Where to POST the ObservationResult once the agent finishes. The ODC app
# exposes a REST endpoint that accepts the webhook payload (status, run_id,
# results, screenshots, ...). The server sends `Authorization: Bearer
# ${BEARER_TOKEN}` on this call. One delivery attempt; on failure the full
# payload is logged at ERROR level for manual recovery.
CALLBACK_URL=https://personal-XXXXXXX-dev.outsystems.app/MyApp/rest/QA/TestRunCompleted

# OutSystems Cloud Connector — values come from your ODC Portal Private
# Gateway page (Connections → Private Gateway → your gateway → Address +
# Token + the remote port assigned to this connector).
ODC_SERVER_URL=https://personal-XXXXXXX-dev.outsystems.app/pgw/sg_XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
ODC_TOKEN=replace-with-the-token-from-the-odc-portal
ODC_REMOTE_PORT=5001

# Host header values allowed on GET /artifacts (DNS-rebinding protection).
# Loopback variants are always allowed, but the Cloud Connector forwards the
# upstream Host unchanged, so the ODC app fetching screenshots arrives as
# `secure-gateway:<ODC_REMOTE_PORT>` (or sometimes bare `secure-gateway`).
# Without these entries /artifacts returns 403 — keep ODC_REMOTE_PORT in sync.
# The submit endpoint (POST /test_user_story) is bearer-only, not host-checked.
ALLOWED_HOSTS=secure-gateway:5001,secure-gateway

# =============================================================================
# Optional — sane defaults are baked into the image.
# =============================================================================

# Show the agent's Chromium window on the host display while it runs the
# tests (lab demo: attendees watch the agent click around in real time).
# Defaults to false (headless) so the stack starts on any host without setup.
# Set to true ONLY on a Linux host/VM with an X server, AND run `xhost +local:`
# beforehand — re-run after every logout/reboot, since xhost permissions reset
# with the X session. Without that, container startup fails to draw and exits.
# LIVE_BROWSER=true

# Container timezone (IANA name). Defaults to UTC; set to your local zone if
# you want logs and timestamps to match host wall-clock time.
# TZ=Europe/Lisbon

# Host port the REST server is published on. The reverse tunnel goes through
# this port locally; rarely needs changing.
# PORT=3100

# How many days of per-run screenshot folders to keep on disk before pruning.
# Pruning runs at startup and after each tool call. 0 disables pruning.
# ARTIFACT_TTL_DAYS=14

# Maximum seconds to wait for one test_user_story call to complete.
# AGENT_TIMEOUT_SECONDS=600

# Maximum milliseconds to wait for the outbound callback POST to complete
# before aborting and logging the failure.
# CALLBACK_TIMEOUT_MS=30000

# OpenClaw agent ID. Only change if you've added a custom agent to
# openclaw.template.json.
# AGENT_ID=qa-executor

# =============================================================================
# Docker image selector — only set these if you've forked the repo.
# =============================================================================
# IMAGE_OWNER=your-github-org-or-user
# IMAGE_TAG=latest
